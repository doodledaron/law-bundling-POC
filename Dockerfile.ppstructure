# Heavy PPStructure worker - includes PaddlePaddle, OpenCV, OCR models
# Runs ppstructure_tasks.py only - no Google Genai
FROM paddlepaddle/paddle:3.0.0

WORKDIR /app

# Install system dependencies for PaddlePaddle and OpenCV
RUN apt-get update --fix-missing && \
    apt-get install -y --fix-missing --no-install-recommends \
        curl \
        build-essential \
        cmake \
        git \
        wget \
        unzip \
        pkg-config \
        libopenblas-dev \
        liblapack-dev \
        libx11-dev \
        libgtk-3-dev \
        libglib2.0-dev \
        libsm6 \
        libxext6 \
        libxrender-dev \
        libgomp1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install poppler-utils for pdf2image
RUN for i in 1 2 3; do \
        apt-get update --fix-missing && \
        apt-get install -y --fix-missing --no-install-recommends \
            poppler-utils \
            && break || sleep 5; \
    done && \
    rm -rf /var/lib/apt/lists/*

# Install additional system libraries for image processing
RUN for i in 1 2 3; do \
        apt-get update --fix-missing && \
        apt-get install -y --fix-missing --no-install-recommends \
            libjpeg-dev \
            libpng-dev \
            libtiff-dev \
            libavcodec-dev \
            libavformat-dev \
            libswscale-dev \
            libv4l-dev \
            libxvidcore-dev \
            libx264-dev \
            libatlas-base-dev \
            gfortran \
            && break || sleep 5; \
    done && \
    rm -rf /var/lib/apt/lists/*

# Install PaddlePaddle 2.6.2 (compatible with PaddleOCR 2.6.1) 
# RUN python -m pip install paddlepaddle==2.6.2 -i https://www.paddlepaddle.org.cn/packages/stable/cpu/

# Install PaddleX and initialize models
RUN pip install paddlex
RUN paddlex --install hpi-cpu

# Create symbolic link for CUDA compatibility (if needed)
RUN if [ -f /usr/local/cuda/lib64/libcuda.so ]; then \
        ln -s /usr/local/cuda/lib64/libcuda.so /usr/lib/libcuda.so.1; \
    fi

# Copy and install Python requirements  
COPY requirements-ppstructure.txt .
RUN pip install --no-cache-dir --ignore-installed PyYAML -r requirements.txt

# Copy application code
COPY . .

# Create non-root user and set permissions
RUN groupadd --gid 1000 app \
    && useradd --create-home --shell /bin/bash --uid 1000 --gid 1000 app \
    && mkdir -p uploads results chunks \
    && chown -R app:app /app

USER app

# Set environment variables for PPStructure worker
ENV WORKER_TYPE=ppstructure
ENV CELERY_WORKER_QUEUES=ppstructure

# Command to run PPStructure worker
CMD ["celery", "-A", "celery_app", "worker", "--loglevel=info", "--queues=ppstructure", "--hostname=worker-ppstructure@%h"] 